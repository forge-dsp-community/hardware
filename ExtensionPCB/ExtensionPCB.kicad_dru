(version 1)
# MEC1 (Edge Mount): Anschlussbeine sitzen bis an die Platinenkante (Samtec-Footprint)
(rule "MEC1 Kontakte an der Platinenkante"
	(condition "A.memberOfFootprint('J2')")
	(constraint edge_clearance (min 0mm))
	(severity ignore))
# Loetfahnen an den gezahnten Ecken: Kupfer bis zur Kante (Kantenmetallisierung)
(rule "Schirm-Loetfahnen an der Kante"
	(condition "A.memberOfFootprint('J7') || A.memberOfFootprint('J8')")
	(constraint edge_clearance (min 0mm))
	(severity ignore))
